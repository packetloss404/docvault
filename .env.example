# ==========================================================================
# DocVault Environment Configuration
# Copy to .env at the repository root and adjust values for your environment.
# Required vars are uncommented. Optional vars are commented with #.
# ==========================================================================

# === Core ===
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=docvault.settings.development
DJANGO_LOG_LEVEL=DEBUG

# === Database ===
DATABASE_URL=postgresql://docvault:docvault@localhost:5432/docvault

# === Redis ===
REDIS_URL=redis://localhost:6379
# Shared Django cache defaults to Redis database 1; task broker/results use database 0.
# CACHE_URL=redis://localhost:6379/1

# === CSRF (production, behind an HTTPS proxy such as Railway) ===
# Comma-separated origins WITH scheme; required for Django admin login.
# CSRF_TRUSTED_ORIGINS=https://docvault.up.railway.app

# === File Storage ===
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles
# Built Angular app (index.html + hashed bundles), served at the URL root.
# Defaults to $STATIC_ROOT/frontend; unset/missing simply disables SPA serving.
# FRONTEND_DIR=./staticfiles/frontend
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=docvault
# S3_REGION=us-east-1

# === CORS ===
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# === Outgoing mail (optional; configure for invitations and email notifications) ===
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=DocVault <noreply@example.com>

# === OIDC / SSO (optional) ===
# OIDC_SERVER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# === Reverse proxy / IP access control ===
# Only these proxy peers may supply X-Forwarded-For. Leave empty for direct connections.
# TRUSTED_PROXY_IPS=10.80.13.11
# IP_WHITELIST=
# IP_BLACKLIST=

# === Retention ===
# Permanent deletion is opt-in; legal holds are preserved in both retention phases.
# RETENTION_HARD_DELETE_ENABLED=false

# === Elasticsearch (optional) ===
# ELASTICSEARCH_ENABLED=false
# ELASTICSEARCH_URL=http://localhost:9200

# === OCR ===
# OCR_LANGUAGE=eng
# OCR_MODE=skip
# OCR_IMAGE_DPI=300
# OCR_DESKEW=true
# OCR_ROTATE=true

# === LLM / AI (optional) ===
# LLM_ENABLED=false
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# === Storage Encryption (optional) ===
# STORAGE_ENCRYPTION_ENABLED=false

# === Sentry (optional) ===
# SENTRY_DSN=
